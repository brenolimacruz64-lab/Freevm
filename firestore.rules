rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Catálogo de títulos:
    // - Qualquer usuário logado pode LER (assistir).
    // - Só o administrador (o e-mail abaixo) pode ESCREVER (adicionar/editar/excluir).
    match /titles/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                   && request.auth.token.email == "brenolimacruz64@gmail.com";
    }
  }
}
